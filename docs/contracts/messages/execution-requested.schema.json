{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testpilot/execution-requested/v1",
  "title": "ExecutionRequested",
  "description": "Core Backend (Job Publisher) -> Runner Worker. Queue: execution.requests (durable, persistent messages, DLQ execution.requests.dlq). One job per worker (prefetch 1); acked only after ExecutionFinished is published.",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "schemaVersion", "executionId", "projectId", "tests", "limits", "sentAt"],
  "properties": {
    "messageId": { "type": "string", "format": "uuid" },
    "schemaVersion": { "const": 1 },
    "executionId": { "type": "string", "format": "uuid" },
    "projectId": { "type": "integer" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testCaseId", "testCaseVersion", "testCode"],
        "properties": {
          "testCaseId": { "type": "integer" },
          "testCaseVersion": { "type": "integer", "minimum": 1 },
          "testCode": { "type": "string", "maxLength": 20000 }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeSeconds", "cpu", "memoryMb"],
      "properties": {
        "timeSeconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 30 },
        "cpu": { "type": "number", "exclusiveMinimum": 0, "maximum": 2, "default": 1 },
        "memoryMb": { "type": "integer", "minimum": 64, "maximum": 1024, "default": 256 }
      }
    },
    "sentAt": { "type": "string", "format": "date-time" }
  }
}
