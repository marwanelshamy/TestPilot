# Copy to .env (never commit .env). Values here are local-only dev defaults.
POSTGRES_PASSWORD=change-me-local
RABBITMQ_PASSWORD=change-me-local
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=60

# AI provider adapter (ASR-5): "mock" works offline and is the default for demo and tests;
# "anthropic" uses Claude (key from ANTHROPIC_API_KEY, never committed - C-08)
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
# C-07: send pasted code under test to an EXTERNAL LLM only when the team approved it
LLM_SEND_CODE=false
LLM_RATE_LIMIT_PER_MINUTE=30
LLM_CACHE_TTL_SECONDS=3600

# Resilience (starting values, tuned in Phase 5).
# AI service worst case ~ LLM_TIMEOUT_SECONDS x (LLM_MAX_RETRIES + 1) = 50 s,
# so the Core Backend must wait longer than that before it gives up:
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
LLM_BREAKER_FAILURE_THRESHOLD=5
LLM_BREAKER_RESET_SECONDS=30
AI_CLIENT_TIMEOUT_SECONDS=60
AI_CLIENT_RETRIES=0
AI_BREAKER_FAILURE_THRESHOLD=5
AI_BREAKER_RESET_SECONDS=30

# Execution limits (QAS-3) and watchdog (OI-007)
RUN_TIME_LIMIT_SECONDS=30
RUN_CPU=1
RUN_MEMORY_MB=256
HEARTBEAT_INTERVAL_SECONDS=5
WATCHDOG_MISSED_HEARTBEATS=3
EVIDENCE_MAX_BYTES=65536
